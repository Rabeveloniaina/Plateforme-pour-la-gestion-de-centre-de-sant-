// Version de fallback sans recharts - à utiliser si recharts n'est pas installé
import { motion } from 'framer-motion';

interface LineChartProps {
  data: number[] | Array<{ name: string; value: number; label?: string }>;
  labels?: string[];
  color?: string;
  height?: number;
  className?: string;
  title?: string;
}

export function LineChart({ 
  data, 
  labels, 
  color = '#3B82F6', 
  height = 250, 
  className = '',
  title 
}: LineChartProps) {
  const chartData = Array.isArray(data) && data.length > 0 && typeof data[0] === 'object'
    ? data as Array<{ name: string; value: number }>
    : (data as number[]).map((value, index) => ({
        name: labels?.[index] || `J${index + 1}`,
        value
      }));

  const maxValue = Math.max(...chartData.map(d => d.value), 1);
  const minValue = Math.min(...chartData.map(d => d.value), 0);
  const range = maxValue - minValue || 1;

  const points = chartData.map((d, i) => {
    const x = (i / (chartData.length - 1 || 1)) * 100;
    const y = 100 - ((d.value - minValue) / range) * 100;
    return `${x},${y}`;
  }).join(' ');

  return (
    <div className={`w-full ${className}`}>
      {title && <h3 className="text-lg font-semibold text-gray-900 mb-4">{title}</h3>}
      <div className="bg-white rounded-lg p-4 border">
        <div className="text-center text-gray-500 text-sm mb-2">
          ⚠️ Recharts non installé - Graphique basique
        </div>
        <svg width="100%" height={height} className="overflow-visible">
          <defs>
            <linearGradient id="lineGradient" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stopColor={color} stopOpacity="0.3" />
              <stop offset="100%" stopColor={color} stopOpacity="0" />
            </linearGradient>
          </defs>
          <polyline
            points={points}
            fill="none"
            stroke={color}
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
          />
          <polygon
            points={`0,${height} ${points} ${chartData.length > 0 ? (chartData.length - 1) * (100 / (chartData.length - 1 || 1)) : 100},${height}`}
            fill="url(#lineGradient)"
          />
        </svg>
      </div>
    </div>
  );
}

interface DonutChartProps {
  data: Array<{ name: string; value: number; color?: string }>;
  height?: number;
  className?: string;
  title?: string;
}

export function DonutChart({ data, height = 250, className = '', title }: DonutChartProps) {
  const total = data.reduce((sum, d) => sum + d.value, 0);
  const colors = data.map((d, i) => d.color || ['#3B82F6', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6'][i % 5]);

  let currentAngle = 0;
  const radius = 80;
  const centerX = 125;
  const centerY = 125;

  const paths = data.map((d, i) => {
    const percentage = (d.value / total) * 100;
    const angle = (d.value / total) * 360;
    const startAngle = currentAngle;
    const endAngle = currentAngle + angle;
    currentAngle = endAngle;

    const x1 = centerX + radius * Math.cos((startAngle - 90) * Math.PI / 180);
    const y1 = centerY + radius * Math.sin((startAngle - 90) * Math.PI / 180);
    const x2 = centerX + radius * Math.cos((endAngle - 90) * Math.PI / 180);
    const y2 = centerY + radius * Math.sin((endAngle - 90) * Math.PI / 180);
    const largeArc = angle > 180 ? 1 : 0;

    return {
      path: `M ${centerX} ${centerY} L ${x1} ${y1} A ${radius} ${radius} 0 ${largeArc} 1 ${x2} ${y2} Z`,
      color: colors[i],
      name: d.name,
      value: d.value,
      percentage
    };
  });

  return (
    <div className={`w-full ${className}`}>
      {title && <h3 className="text-lg font-semibold text-gray-900 mb-4">{title}</h3>}
      <div className="bg-white rounded-lg p-4 border">
        <div className="text-center text-gray-500 text-sm mb-2">
          ⚠️ Recharts non installé - Graphique basique
        </div>
        <svg width="100%" height={height} viewBox="0 0 250 250">
          {paths.map((p, i) => (
            <g key={i}>
              <path d={p.path} fill={p.color} stroke="white" strokeWidth="2" />
            </g>
          ))}
          <circle cx={centerX} cy={centerY} r="50" fill="white" />
          <text x={centerX} y={centerY - 10} textAnchor="middle" className="text-2xl font-bold fill-gray-900">
            {total}
          </text>
          <text x={centerX} y={centerY + 15} textAnchor="middle" className="text-sm fill-gray-600">
            Total
          </text>
        </svg>
        <div className="mt-4 space-y-2">
          {paths.map((p, i) => (
            <div key={i} className="flex items-center justify-between text-sm">
              <div className="flex items-center">
                <div className="w-3 h-3 rounded mr-2" style={{ backgroundColor: p.color }} />
                <span>{p.name}</span>
              </div>
              <span className="font-medium">{p.value} ({p.percentage.toFixed(1)}%)</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

interface BarChartProps {
  data: Array<{ name: string; value: number; color?: string }>;
  height?: number;
  className?: string;
  title?: string;
}

export function BarChart({ data, height = 250, className = '', title }: BarChartProps) {
  const maxValue = Math.max(...data.map(d => d.value), 1);
  const colors = data.map((d, i) => d.color || '#3B82F6');

  return (
    <div className={`w-full ${className}`}>
      {title && <h3 className="text-lg font-semibold text-gray-900 mb-4">{title}</h3>}
      <div className="bg-white rounded-lg p-4 border">
        <div className="text-center text-gray-500 text-sm mb-4">
          ⚠️ Recharts non installé - Graphique basique
        </div>
        <svg width="100%" height={height} className="overflow-visible">
          {data.map((d, i) => {
            const barHeight = (d.value / maxValue) * (height - 60);
            const barWidth = (100 / data.length) * 0.8;
            const x = (i / data.length) * 100 + (100 / data.length) * 0.1;
            const y = height - barHeight - 40;

            return (
              <g key={i}>
                <rect
                  x={`${x}%`}
                  y={y}
                  width={`${barWidth}%`}
                  height={barHeight}
                  fill={colors[i]}
                  rx="4"
                />
                <text
                  x={`${x + barWidth / 2}%`}
                  y={y - 5}
                  textAnchor="middle"
                  className="text-xs fill-gray-700"
                >
                  {d.value}
                </text>
                <text
                  x={`${x + barWidth / 2}%`}
                  y={height - 20}
                  textAnchor="middle"
                  className="text-xs fill-gray-600"
                >
                  {d.name}
                </text>
              </g>
            );
          })}
        </svg>
      </div>
    </div>
  );
}

